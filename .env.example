# Trade-Dash Phase 1 (MMP v1.0) environment variables.
#
# Copy to `.env` and fill in real values. NEVER commit `.env` with real
# secrets (NFR-05: all API keys/webhook URLs in environment variables,
# never hardcoded). `docker-compose.yml` reads this file automatically via
# `env_file: .env` for the `api` service; local (non-Docker) runs of
# `uvicorn api_service:app` / `python event_bus.py` read it via your shell
# or a tool like `python-dotenv` / `direnv`.

# --- Core infrastructure (required) -----------------------------------------

# Postgres/TimescaleDB connection string. Matches docker-compose.yml's
# `postgres` service (user/password/db below) when running via Compose.
DATABASE_URL=postgresql://trade_dash:trade_dash@localhost:5432/trade_dash

# Redis connection string. Matches docker-compose.yml's `redis` service.
REDIS_URL=redis://localhost:6379/0

# --- Data source API keys (Phase 1 pollers: event_bus.py) -------------------

FINNHUB_API_KEY=your_finnhub_api_key
COINGLASS_API_KEY=your_coinglass_api_key
POLYGON_API_KEY=your_polygon_api_key

# --- Alert delivery (event_bus.py's AlertRouter) ----------------------------

SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# --- Agentic research workspace runtimes (Phase 3 -- not yet built, but the
#     env-var contract is reserved now per CLAUDE.md §6 Quick Start) --------

OPENROUTER_API_KEY=your_openrouter_api_key
OLLAMA_BASE_URL=http://localhost:11434

# --- Frontend (frontend/.env.local, NOT this file -- Next.js only reads
#     NEXT_PUBLIC_* vars from its own project directory) -------------------
# See frontend/.env.example for NEXT_PUBLIC_API_HOST.

# --- Postgres container credentials (docker-compose.yml only) --------------
# These back DATABASE_URL above when running via `docker-compose up`; if
# you point DATABASE_URL at a different (e.g. managed) Postgres instance,
# these three are unused.
POSTGRES_USER=trade_dash
POSTGRES_PASSWORD=trade_dash
POSTGRES_DB=trade_dash
